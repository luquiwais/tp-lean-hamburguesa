# Copiar a server/.env y completar. Nunca commitear el .env real.

NODE_ENV=development
PORT=4000

# Origenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Supabase. La secret/service_role key SOLO vive en el backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT (minimo 32 caracteres). Generar cada uno con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Opcionales (estos son los valores por defecto)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7
# COOKIE_SAMESITE=lax   # con el rewrite de Vercel el front y el back son el mismo sitio: lax
# TRUST_PROXY=1         # proxies delante del server; en el deploy (Vercel -> Render): 2
