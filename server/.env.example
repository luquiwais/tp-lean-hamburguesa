# Copiar a server/.env y completar. Nunca commitear el .env real.

NODE_ENV=development
PORT=4000

# Origenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Supabase (Fase 1). La service role key SOLO vive en el backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT (Fase 3). Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
